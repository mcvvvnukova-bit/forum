{
  "name": "okved-parser",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "migrate:up": "node-pg-migrate up --migrations-dir migrations",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --count 1",
    "audience": "tsx src/apps/browser-runner/main.ts",
    "okved-release": "tsx src/apps/okved-release/main.ts",
    "worker": "tsx src/apps/worker/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "fflate": "0.8.2",
    "pg": "8.23.0",
    "pg-boss": "12.28.0",
    "playwright": "1.62.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
