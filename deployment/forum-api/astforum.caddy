    @astforum host astforum.ru
    handle @astforum {
        encode zstd gzip
        header {
            Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob:; script-src 'self' https://cal.astforum.ru; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://cal.astforum.ru; frame-src 'self' https://cal.astforum.ru"
            Referrer-Policy "no-referrer"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
        }

        @forum_api path /authorization /auth/sber-id/* /api/auth/*
        handle @forum_api {
            reverse_proxy forum_api:3001 {
                header_up -Forwarded
                header_up X-Forwarded-Proto https
                header_up X-Forwarded-Host {http.request.host}
            }
        }

        handle {
            root * /srv/astforum
            @forum_index path / /index.html
            header @forum_index Cache-Control "no-cache"
            file_server
        }
    }
