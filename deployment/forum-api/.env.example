PUBLIC_ORIGIN=https://dev.astforum.ru
DATABASE_URL_FILE=/run/secrets/forum-database-url
SESSION_TTL_SECONDS=86400
FORUM_FRONTEND_NETWORK=outline_frontend
FORUM_DATABASE_NETWORK=outline_backend
TRUSTED_PROXY_CIDRS=
SBER_ID_ENABLED=false
SBER_ID_ENVIRONMENT=production
SBER_ID_CLIENT_ID=
SBER_ID_CLIENT_SECRET_FILE=/run/secrets/sber-client-secret
SBER_ID_REDIRECT_URI=https://dev.astforum.ru/auth/sber-id/callback
# For the approved main-domain callback relay, use the main /authorization URI
# above and set this origin explicitly:
# SBER_ID_CALLBACK_RELAY_ORIGIN=https://astforum.ru
SBER_ID_AUTHORIZE_URL=https://id.sber.ru/CSAFront/oidc/authorize.do
SBER_ID_ISSUER=id.sber.ru
SBER_ID_SCOPE=openid
SBER_ID_TOKEN_SIGNING_ALG=none
SBER_ID_CERT_FILE=/run/secrets/sber-client.crt
SBER_ID_KEY_FILE=/run/secrets/sber-client.key
# SBER_ID_CA_FILE=/run/secrets/sber-ca.pem
