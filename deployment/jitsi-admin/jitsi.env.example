# Append these public settings to the existing /opt/jitsi-meet/.env.
# connect_jitsi.py reads the shared secret from the private portal file.
ENABLE_AUTH=1
ENABLE_GUESTS=1
AUTH_TYPE=jwt
JWT_APP_ID=vks-jitsi-admin
JWT_APP_SECRET=<read from private access file; never commit the actual value>
JWT_ACCEPTED_ISSUERS=vks-jitsi-admin
JWT_ACCEPTED_AUDIENCES=jitsi_admin
JWT_ALLOW_EMPTY=0
JWT_SIGN_TYPE=HS256
# External hostname differs from the internal XMPP domain meet.jitsi.
JWT_ENABLE_DOMAIN_VERIFICATION=0
ENABLE_AUTO_OWNER=0
ENABLE_LOBBY=1
WAIT_FOR_HOST_DISABLE_AUTO_OWNERS=true
XMPP_CONFIGURATION=
XMPP_MODULES=forum_persistent_lobby
XMPP_MUC_MODULES=token_affiliation,muc_wait_for_host
XMPP_MUC_CONFIGURATION=token_verification_require_token_for_moderation = true; token_regex_enabled = false;
TOKEN_AUTH_URL=https://vks.mvpspace.ru/admin/host?room={room}
