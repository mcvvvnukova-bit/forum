HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:4173
DATABASE_URL=postgres://postgres:local-auth-tests@127.0.0.1:55432/forum_auth_test
SESSION_TTL_SECONDS=86400
# Trust only the actual reverse proxy addresses; never use a wildcard.
TRUSTED_PROXY_CIDRS=

SBER_ID_ENABLED=false
SBER_ID_ENVIRONMENT=production
SBER_ID_CLIENT_ID=
SBER_ID_CLIENT_SECRET_FILE=./secrets/sber-client-secret
SBER_ID_REDIRECT_URI=http://127.0.0.1:4173/auth/sber-id/callback
# Only for an approved cross-origin /authorization relay to PUBLIC_ORIGIN:
# SBER_ID_CALLBACK_RELAY_ORIGIN=https://astforum.ru
# Use the authorization URL and issuer assigned for this application's contour.
SBER_ID_AUTHORIZE_URL=https://id.sber.ru/CSAFront/oidc/authorize.do
SBER_ID_ISSUER=id.sber.ru
SBER_ID_SCOPE=openid
# Must match the registered response algorithm. Unsigned tokens are accepted only
# from the server's mTLS token exchange, never as client-supplied credentials.
SBER_ID_TOKEN_SIGNING_ALG=none
SBER_ID_CERT_FILE=./secrets/sber-client.crt
SBER_ID_KEY_FILE=./secrets/sber-client.key
# SBER_ID_CA_FILE=./secrets/sber-ca.pem
# SBER_ID_KEY_PASSPHRASE_FILE=./secrets/sber-key-passphrase
# For RS256 only:
# SBER_ID_SIGNING_PUBLIC_KEY_FILE=./secrets/sber-signing-public.pem
