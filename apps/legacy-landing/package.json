{
  "name": "@astforum/legacy-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-runtime.mjs && vite build && vite build --config vite.landing.config.ts && node scripts/finalize-landing-build.mjs",
    "test": "npm run test:frontend && npm run test:gateway && npm run test:layout",
    "test:frontend": "vitest run src",
    "test:gateway": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:layout": "npm run build && node ../../tests/e2e/legacy-landing-layout.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@calcom/embed-react": "1.5.3",
    "@primer/octicons-react": "19.33.0",
    "@primer/primitives": "11.10.0",
    "@primer/react": "38.37.0",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "jsdom": "27.0.0",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
