    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/node": "^24.19.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "jsdom": "27.0.0",
    "typescript": "5.9.2",
    "vite": "8.2.2",
