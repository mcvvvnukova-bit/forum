    "deployment/openproject/patches/query-sums/custom_field_select.rb",
    "deployment/openproject/patches/query-sums/query_currency_select.rb",
    "deployment/openproject/patches/query-sums/sums.rb",
    "deployment/vps/outline/Caddyfile.example",
    "deployment/vps/outline/compose.yaml",
    "deployment/vps/outline/dev-landing-api.override.yaml",
    "deployment/astforum-static/favicon.png",
