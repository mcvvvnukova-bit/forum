{
  "schemaVersion": 1,
  "documentation": {
    "root": "docs",
    "strictPlansOnly": true
  },
  "packages": [
    {
      "path": ".",
      "name": "@astforum/repository",
      "scripts": {
        "test:composition": "vitest run --config vitest.composition.config.ts",
        "build": "npm run build --workspaces",
        "typecheck": "npm run typecheck --workspaces",
        "test:mail": "python3 scripts/verification/check-mail-resources.py && node tests/e2e/mail-resources.mjs",
        "check:layout": "node scripts/verification/check-repository-layout.mjs",
        "test:publishers": "python3 -m unittest discover -s tests/integration -p 'test_public_site_release.py' -v",
        "check:primer": "python3 scripts/verification/check-primer-ui.py",
        "test:primer": "python3 -m unittest discover -s tests/integration -p 'test_primer_ui_policy.py' -v"
      },
      "entrypoints": [
        "vitest.composition.config.ts",
        "scripts/verification/check-primer-ui.py"
      ],
      "tests": [
        "tests/integration/public-site-composition.test.tsx",
        "tests/integration/test_primer_ui_policy.py"
      ]
    },
    {
      "path": "apps/api",
      "name": "@astforum/api",
      "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.test.json --noEmit",
        "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-build/test/*.test.js",
        "test:browser": "tsc -p tsconfig.test.json && node test/browser-smoke.mjs",
        "start": "node --env-file-if-exists=.env dist/main.js",
        "migrate": "node --env-file-if-exists=.env dist/migrate.js"
      },
      "entrypoints": [
        "src/main.ts",
        "src/migrate.ts",
        "test/browser-smoke.mjs",
        "diagnostics/issuer-probe.mjs"
      ],
      "tests": [
        "diagnostics/issuer-probe.test.mjs",
        "test/auth.test.ts",
        "test/browser-smoke.mjs",
        "test/config.test.ts",
        "test/migrate.test.ts",
        "test/test-database.test.ts",
        "test/tls.test.ts"
      ]
    },
    {
      "path": "apps/dev-gateway",
      "name": "@astforum/dev-gateway",
      "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "test:frontend": "vitest run src",
        "test:gateway": "python3 -m unittest discover -s tests -p 'test_*.py'",
        "test": "npm run test:frontend && npm run test:gateway"
      },
      "entrypoints": [
        "index.html",
        "vite.config.ts",
        "src/main.tsx",
        "forum_dev_auth.py"
      ],
      "tests": [
        "src/AuthScreen.test.tsx",
        "tests/test_auth_gateway.py",
        "tests/test_origin_login_check.py"
      ]
    },
    {
      "path": "apps/profile-preview",
      "name": "@astforum/profile-preview",
      "scripts": {
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint src"
      },
      "entrypoints": [
        "index.html",
        "src/main.tsx",
        "src/ProfilePage.tsx"
      ],
      "tests": [
        "src/App.test.tsx",
        "src/ProfilePage.test.tsx",
        "src/profile.test.ts"
      ]
    },
    {
      "path": "apps/web",
      "name": "@astforum/web",
      "scripts": {
        "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vitest run",
        "preview": "vite preview --host 127.0.0.1 --port 5188 --strictPort"
      },
      "entrypoints": [
        "index.html",
        "src/main.tsx",
        "src/App.tsx",
        "scripts/immutable-media.ts"
      ],
      "tests": [
        "src/App.test.tsx",
        "src/audience/audience.test.tsx",
        "src/audience/intent.test.ts",
        "src/audience/resume.test.ts",
        "src/auth/PublicAuth.test.tsx",
        "src/auth/main.test.tsx",
        "src/auth/session.test.ts",
        "src/home/home.test.tsx",
        "src/home/useForumSession.test.tsx"
      ]
    }
  ],
